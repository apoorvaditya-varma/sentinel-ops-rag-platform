# Copy this file to .env and fill in the values.  `.env` is git-ignored and is
# never pushed to GitHub.

# ---- Application -----------------------------------------------------------
APP_NAME="Sentinel Ops RAG Platform"
# Web server (localhost only by default; there is no login, so keep it local)
WEB_HOST=127.0.0.1
WEB_PORT=7400

# ---- Logging ---------------------------------------------------------------
# Levels: DEBUG, INFO, WARNING, ERROR. Files: logs/app.log, logs/errors.log, logs/audit.log
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIR=logs
# Rotation: size (LOG_MAX_MB per file) | time (every LOG_ROTATE_WHEN) | off
LOG_ROTATION=size
LOG_MAX_MB=10
# Time rotation interval: midnight, H (hourly), D (daily), W0-W6 (weekly on Mon..Sun)
LOG_ROTATE_WHEN=midnight
LOG_BACKUP_COUNT=5
# text (human readable) or json (one object per line, for log shippers / SIEM)
LOG_FORMAT=text

# ---- LLMs ------------------------------------------------------------------
# Format is "<provider>:<model>" (LangChain init_chat_model). Providers: google_genai, openai, anthropic.
# These are the defaults; the Settings page can override the models and store keys here.
# Keys: https://aistudio.google.com/apikey · https://platform.openai.com/api-keys · https://platform.claude.com/settings/keys
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Strong model: planning, answer synthesis, table analysis.
LLM_MODEL=google_genai:gemini-3.8-flash
# Fast/cheap model: routing, relevance grading, groundedness validation.
LLM_FAST_MODEL=google_genai:gemini-3.5-flash-lite
LLM_TEMPERATURE=0.1

# ---- Local retrieval models (no API key; downloaded once to .cache/) ---------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# ---- Retrieval -------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# Hybrid search returns FETCH_K candidates; the reranker keeps the best TOP_K.
FETCH_K=20
TOP_K=5
# Corrective-RAG: max query rewrites when retrieved context is graded irrelevant.
MAX_RETRIEVAL_RETRIES=2
# Reviewer can send an answer back to the writer this many times.
MAX_ANSWER_RETRIES=1
# Safety limit on agent steps per question, and per-call LLM timeout (seconds).
AGENT_RECURSION_LIMIT=25
LLM_TIMEOUT_S=30
# Retries per LLM call on rate limits / overload (503) / timeouts, with backoff 2s, 4s, 8s...
LLM_RETRY_ATTEMPTS=4
COLLECTION_NAME=ops_knowledge

# ---- Upload guardrails --------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=300
# Topic screening: margin = similarity to platform domains minus similarity to
# off-topic subjects.  >= ACCEPT -> accepted; < REJECT -> rejected; in between
# the fast LLM decides (or the file needs manual review if no API key).
RELEVANCE_ACCEPT_MARGIN=0.05
RELEVANCE_REJECT_MARGIN=0.0
# Show "Ingest anyway" for files that need review.
ALLOW_RELEVANCE_OVERRIDE=true

# ---- Optional: LangSmith tracing --------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sentinel-ops-rag-platform
